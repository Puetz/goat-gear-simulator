{
  "name": "goat-gear-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Gear stat simulator for GOAT: pick items and see the stats, tags and chromatic bonuses they give.",
  "license": "MIT",
  "homepage": "https://puetz.github.io/goat-gear-simulator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Puetz/goat-gear-simulator.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "catalog:check": "node scripts/catalog-check.ts",
    "schema": "node scripts/generate-schema.ts",
    "verify": "biome check . && tsc -b && node scripts/catalog-check.ts && vitest run && vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@biomejs/biome": "^2.6.5",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
